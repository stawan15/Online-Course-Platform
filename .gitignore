# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE and Editor Specific Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.ruby-lsp/
.tmproj
*.swp
*~
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.netrwhist

# --- Ruby/Rails Specific ---
/.bundle/
/vendor/bundle/
/vendor/cache/
/vendor/ruby/
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/public/packs
/public/packs-test
/node_modules/
/coverage/
/app/assets/builds/*
!/app/assets/builds/.keep
*.key

# --- Database Specific ---
/db/*.sqlite3
/db/*.sqlite3-*
/db/schema_cache.yml

# --- Environment Specific ---
/.env*

# --- Project Specific Transient Files ---
/public/screenshots/
/public/system/
