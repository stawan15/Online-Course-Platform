<div class="flex flex-col gap-2">
  <%- if controller_name != 'sessions' %>
    <%= link_to "เข้าสู่ระบบ", new_session_path(resource_name), class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "สมัครสมาชิก", new_registration_path(resource_name), class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "ลืมรหัสผ่าน?", new_password_path(resource_name), class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "ไม่ได้รับอีเมลยืนยัน?", new_confirmation_path(resource_name), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "ไม่ได้รับคำแนะนำการปลดล็อกบัญชี?", new_unlock_path(resource_name), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "เข้าใช้งานด้วย #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full text-center text-sm font-medium border border-gray-300 py-2 rounded shadow-sm hover:bg-gray-50 transition" %>
    <% end %>
  <% end %>
</div>
