<div class="min-h-screen bg-slate-50">
  <div class="bg-blue-600 pt-20 pb-12 px-4 sm:px-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-blue-400/20 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-blue-100 uppercase tracking-widest backdrop-blur-sm border border-white/20 mb-4 cursor-default">
        บทเรียนยอดเยี่ยม
      </span>
      <h1 class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight max-w-3xl mx-auto"><%= @lesson.title %></h1>
      <% if @lesson.course %>
      <div class="inline-flex items-center justify-center space-x-2 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-md border border-white/10">
        <span class="text-blue-100 text-sm">จากคอร์ส:</span>
        <%= link_to @lesson.course.title, course_path(@lesson.course), class: "text-white font-bold hover:underline transition-all" %>
      </div>
      <% end %>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-8 pb-16">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl shadow-slate-200/50 border border-slate-100 mt-10">
      <div class="prose prose-slate prose-lg max-w-none text-slate-700 leading-relaxed mb-12">
        <%= simple_format @lesson.description %>
      </div>
      
      <div class="flex flex-col sm:flex-row items-center justify-between pt-8 border-t border-slate-100 gap-4">
        <%= link_to lessons_path, class: "inline-flex items-center text-sm font-bold text-slate-500 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปหน้ารวมบทเรียน
        <% end %>
        <div class="flex items-center gap-3">
          <% if can? :edit, @lesson %>
            <%= link_to edit_lesson_path(@lesson), class: "inline-flex items-center justify-center px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold rounded-xl transition-all" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              แก้ไข
            <% end %>
          <% end %>
            
        </div>
      </div>
    </div>
  </div>
</div>
