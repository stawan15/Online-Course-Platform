<div class="min-h-screen bg-slate-50">
  <div class="bg-blue-600 pt-20 pb-12 px-4 sm:px-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-blue-400/20 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-blue-100 uppercase tracking-widest backdrop-blur-sm border border-white/20 mb-4 cursor-default">
        บทเรียนยอดเยี่ยม
      </span>
      <h1 class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight max-w-3xl mx-auto"><%= @lesson.title %></h1>
      <% if @lesson.course %>
      <div class="inline-flex items-center justify-center space-x-2 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-md border border-white/10">
        <span class="text-blue-100 text-sm">จากคอร์ส:</span>
        <%= link_to @lesson.course.title, course_path(@lesson.course), class: "text-white font-bold hover:underline transition-all" %>
      </div>
      <% end %>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-8 pb-16">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl shadow-slate-200/50 border border-slate-100 mt-10">
      <div class="prose prose-slate prose-lg max-w-none text-slate-700 leading-relaxed mb-12">
        <%= simple_format @lesson.description %>
      </div>
      
      <%# --- Quizzes Section --- %>
      <div class="mb-12">
        <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center">
          <span class="w-1.5 h-6 bg-teal-500 rounded-full mr-2.5"></span>
          แบบทดสอบ
        </h3>
        <%if can? :create, Quiz %>
          <%= link_to new_quiz_path, class: "inline-flex items-center justify-center px-5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-bold rounded-xl shadow-lg shadow-teal-100 transition-all duration-200 cursor-pointer active:scale-95 mb-10" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            สร้างแบบทดสอบใหม่
          <% end %>
        <% end %>
        <% if @lesson.quizzes.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% @lesson.quizzes.each_with_index do |quiz, index| %>
              <%= link_to quiz_path(quiz), class: "group bg-slate-50 border border-slate-100 p-5 rounded-2xl hover:bg-white hover:shadow-md hover:shadow-teal-100/50 transition-all duration-300 hover:border-teal-200 flex items-center justify-between" do %>
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm shadow-sm group-hover:scale-110 transition-transform duration-300">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <span class="text-sm font-bold text-slate-800 group-hover:text-teal-700 transition-colors line-clamp-2"><%= quiz.question %></span>
                  </div>
                </div>
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white flex items-center justify-center border border-slate-200 group-hover:border-teal-300 group-hover:bg-teal-50 text-slate-400 group-hover:text-teal-600 transition-all duration-300 shadow-sm ml-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
            <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <p class="text-slate-500 text-sm font-medium">ยังไม่มีแบบทดสอบสำหรับบทเรียนนี้</p>
          </div>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between pt-8 border-t border-slate-100 gap-4">
        <%= link_to lessons_path, class: "inline-flex items-center text-sm font-bold text-slate-500 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปหน้ารวมบทเรียน
        <% end %>
        <div class="flex items-center gap-3">
          <% if can? :edit, @lesson %>
            <%= link_to edit_lesson_path(@lesson), class: "inline-flex items-center justify-center px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold rounded-xl transition-all" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              แก้ไข
            <% end %>
          <% end %>
            
        </div>
      </div>
    </div>
  </div>
</div>
