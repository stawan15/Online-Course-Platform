<%= form_with(model: lesson, class: "space-y-5") do |form| %>
  <% if lesson.errors.any? %>
    <div id="error_explanation" class="bg-red-50 p-4 rounded-xl border border-red-100">
      <div class="flex items-center space-x-2 text-red-800 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-bold text-sm">ไม่สามารถบันทึกได้ (<%= lesson.errors.count %> ข้อ)</span>
      </div>
      <ul class="list-disc list-inside text-sm text-red-600 ml-7 space-y-1">
        <% lesson.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :course_id, "คอร์สเรียน", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.collection_select :course_id, Course.all, :id, :title, { prompt: "เลือกคอร์สเรียน" },
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none" %>
  </div>

  <div>
    <%= form.label :title, "ชื่อบทเรียน", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.text_field :title, 
        placeholder: "ตั้งชื่อบทเรียนให้กระชับ...",
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none" %>
  </div>

  <div>
    <%= form.label :description, "เนื้อหาบทเรียน", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.text_area :description, 
        rows: 6,
        placeholder: "อธิบายถึงเนื้อหาเบื้องต้นของบทเรียนนี้...",
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none resize-none" %>
  </div>

  <div>
    <%= form.label :youtube_url, "URL วิดีโอ YouTube (ถ้ามี)", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <div class="relative group">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-indigo-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </div>
      <%= form.text_field :youtube_url, 
          placeholder: "ตัวอย่าง: https://www.youtube.com/watch?v=...",
          class: "block w-full pl-11 pr-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none" %>
    </div>
    <p class="mt-1.5 text-[11px] text-slate-400 ml-1">รองรับทั้งลิงก์แบบยาวและแบบสั้น (youtu.be)</p>
  </div>

  <div class="pt-4">
    <%= form.submit class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-base font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-indigo-100 transition-all duration-200 cursor-pointer active:scale-95" %>
  </div>
<% end %>