<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-12">
      <div class="mb-10 text-center">
        <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-blue-100 transform -rotate-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h1 class="text-3xl font-black text-slate-900 mb-2">สร้างบทเรียนใหม่</h1>
        <p class="text-slate-500 text-base">มอบความรู้และแบ่งปันให้ผู้อื่นต่อไป</p>
      </div>

      <%= render "form", lesson: @lesson %>

      <div class="mt-8 text-center border-t border-slate-100 pt-8">
        <%= link_to lessons_path, class: "inline-flex items-center text-sm font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปหน้ารวมบทเรียน
        <% end %>
      </div>
    </div>
  </div>
</div>