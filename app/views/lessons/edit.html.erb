<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-12">
      <div class="mb-10 text-center">
        <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-blue-100 transform rotate-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
        </div>
        <h1 class="text-3xl font-black text-slate-900 mb-2">แก้ไขบทเรียน</h1>
        <p class="text-slate-500 text-base">ปรับปรุงข้อมูลและเนื้อหาให้สมบูรณ์ขึ้น</p>
      </div>

      <%= render "form", lesson: @lesson %>

      <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-8 px-2">
        <%= link_to lesson_path(@lesson), class: "inline-flex items-center text-sm font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          ดูหน้าบทเรียน
        <% end %>

        <%= link_to lessons_path, class: "inline-flex items-center text-sm font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปรวมบทเรียน
        <% end %>
      </div>
    </div>
  </div>
</div>
