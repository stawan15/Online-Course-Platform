<div class="min-h-screen bg-slate-50">
  <!-- Hero Section -->
  <div class="bg-indigo-900 pt-20 pb-12 px-4 sm:px-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
    
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="flex items-center space-x-3 mb-4">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/30 text-indigo-100 uppercase tracking-widest backdrop-blur-sm border border-indigo-400/30">
              Course
            </span>
            <span class="text-indigo-300 text-xs">
              อัปเดตล่าสุด <%= @course.updated_at.strftime("%d %b %Y") %>
            </span>
          </div>
          <h1 class="text-3xl md:text-4xl font-black text-white mb-4 leading-tight"><%= @course.title %></h1>
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white text-xs font-bold border border-indigo-400 shadow capitalize">
              <%= (@course.user.name.presence || @course.user.email).first %>
            </div>
            <div class="text-indigo-100 text-sm">
              <p class="font-bold"><%= @course.user.name.presence || @course.user.email %></p>
            </div>
          </div>
        </div>
        
        <div class="flex space-x-2">


          <% if can? :edit, @course %>
            <%= link_to edit_course_path(@course), class: "inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-900 text-sm font-bold rounded-xl shadow transition-all duration-200 active:scale-95" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              แก้ไข
            <% end %>
          <% end %>



          <% if can? :destroy, @course %>
            <%= button_to course_path(@course), method: :delete, data: { turbo_confirm: "ต้องการย้ายคอร์สนี้ไปที่ถังขยะใช่หรือไม่?" }, class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-xl shadow transition-all duration-200 active:scale-95 cursor-pointer" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-6 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-100 mt-10">
          <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
            <span class="w-1.5 h-6 bg-indigo-600 rounded-full mr-2"></span>
            รายละเอียดคอร์ส
          </h2>
          <div class="text-slate-600 leading-relaxed text-base">
            <%= simple_format @course.description %>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-100 mt-10 ">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-slate-900 flex items-center">
              <span class="w-1.5 h-6 bg-blue-500 rounded-full mr-2"></span>
              บทเรียน
            </h2>
            <span class="text-slate-400 text-xs font-medium"><%= @course.lessons.count %> บทเรียน</span>
          </div>
          
          <% if @course.lessons.any? %>
            <div class="space-y-2">
              <% @course.lessons.each_with_index do |lesson, index| %>
                <div class="group flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all">
                  <div class="flex items-center space-x-3">
                    <span class="w-6 h-6 flex items-center justify-center rounded-lg bg-slate-100 text-slate-500 text-xs font-bold group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                      <%= index + 1 %>
                    </span>
                    <h3 class="font-bold text-sm text-slate-700 group-hover:text-slate-900"><%= lesson.title %></h3>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 text-slate-300 group-hover:text-indigo-500 transform group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8 bg-slate-50/50 rounded-xl border-2 border-dashed border-slate-200">
              <p class="text-slate-400 text-sm">ยังไม่มีบทเรียน</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Action Sidebar -->
      <div class="lg:col-span-1">
        <div class="space-y-6">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 mt-10">
            <h3 class="text-lg font-bold text-slate-900 mb-4">สถานะ</h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="text-slate-500">สถานะคอร์ส</span>
                <span class="font-bold text-emerald-600 flex items-center">
                  Active
                </span>
              </div>
              <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                <div class="bg-indigo-600 h-full w-[100%] rounded-full"></div>
              </div>
            </div>
            
            <div class="mt-6 pt-6 border-t border-slate-100">
              <%= link_to courses_path, class: "flex items-center justify-center w-full py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold rounded-xl transition-all" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                กลับไปรวมคอร์ส
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
