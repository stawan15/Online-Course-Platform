<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6">
  <div class="max-w-lg mx-auto">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-10">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-black text-slate-900 mb-1">แก้ไขคอร์สเรียน</h1>
        <p class="text-slate-500 text-sm">ปรับปรุงคอร์สเรียนของคุณ</p>
      </div>

      <%= render "form", course: @course %>

      <div class="mt-6 flex items-center justify-between border-t border-slate-50 pt-6 px-1">
        <%= link_to course_path(@course), class: "inline-flex items-center text-xs font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          ดูรายละเอียด
        <% end %>

        <%= link_to courses_path, class: "inline-flex items-center text-xs font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปหน้ารายการ
        <% end %>
      </div>
    </div>
  </div>
</div>