<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">คอร์สเรียนทั้งหมด</h1>
        <p class="text-slate-500 text-sm">จัดการและดูแลคอร์สเรียนของคุณ</p>
      </div>
      <% if can? :create, Course %>
        <%= link_to new_course_path, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all duration-200 active:scale-95 group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5 group-hover:rotate-90 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          สร้างคอร์สใหม่
        <% end %>
      <%end%>
    </div>

    <!-- Active Courses Grid -->
    <% if @courses.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <% @courses.each do |course| %>
          <div class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col h-full hover:-translate-y-0.5">
            <div class="p-6 flex-grow">
              <div class="flex justify-between items-start mb-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-indigo-100 text-indigo-700 uppercase tracking-wider border border-indigo-200">
                  Active
                </span>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  
                <%if can? :update, course %>  
                  <%= link_to edit_course_path(course), class: "p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg> 
                  <% end %>
                <%end%>
                
                <%if current_user.has_role?(:nil) %>
                    <%link_to course_path(course), class: "p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    <%end%>
                <%end%>

                  <% if can? :destroy, course %>
                    <%= button_to course_path(course), method: :delete, data: { turbo_confirm: "ต้องการย้ายคอร์สนี้ไปที่ถังขยะใช่หรือไม่?" }, class: "p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <h2 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors line-clamp-1"><%= course.title %></h2>
              <p class="text-slate-500 text-xs leading-relaxed line-clamp-2 mb-4">
                <%= course.description.presence || "ไม่มีคำอธิบายสำหรับคอร์สนี้" %>
              </p>
            </div>

            <%if can? :show, @course %>
              <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-50 mt-auto">
                <%= link_to course_path(course), class: "flex items-center justify-between group/link text-indigo-600 text-sm font-bold" do %>
                  <span>จัดการคอร์สเรียน</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="h-3.5 w-3.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                <% end %>
              </div>
            <%else%>
              <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-50 mt-auto">
                <%= link_to course_path(course), class: "flex items-center justify-between group/link text-indigo-600 text-sm font-bold" do %>
                  <span>ดูรายละเอียดคอร์ส</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="h-3.5 w-3.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                <% end %>
              </div>
            <% end%>


          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl border-2 border-dashed border-slate-200 mb-8">
        <div class="bg-indigo-50 w-12 h-12 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="h-6 w-6 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">ยังไม่มีคอร์สเรียน</h3>
        <p class="text-slate-500 text-sm mb-6">เริ่มต้นสร้างคอร์สเรียนแรกของคุณ</p>
        <%= link_to "สร้างคอร์สใหม่", new_course_path, class: "text-indigo-600 text-sm font-bold hover:text-indigo-700 underline underline-offset-4" %>
      </div>
    <% end %>

    <!-- Trash Section -->

    <% if can? :restore, Course.new %>
    <div class="clear-both pt-8"></div>
      <% if @deleted_courses.any? %>
        <h2 class="text-xl font-bold text-slate-900 mb-4">คอร์สที่ถูกลบ</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @deleted_courses.each do |course| %>
            <div class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col h-full hover:-translate-y-0.5">
              <div class="p-6 flex-grow">
                <h3 class="text-lg font-bold text-slate-900 mb-2"><%= course.title %></h3>
                <p class="text-sm text-slate-500 mb-4"><%= course.description %></p>
                <%= button_to restore_course_path(course), method: :post, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-bold rounded-xl text-white bg-green-600 hover:bg-green-700 shadow-lg shadow-green-200 transition-all duration-200 active:scale-95" do %>
                  กู้คืนคอร์ส
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>