<%= form_with(model: course, class: "space-y-4") do |form| %>
  <% if course.errors.any? %>
    <div id="error_explanation" class="bg-red-50 p-3 rounded-xl border border-red-100">
      <div class="flex items-center space-x-2 text-red-800 mb-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-bold text-xs">
            ไม่สามารถบันทึกได้ (<%= course.errors.count %> ข้อ)</span>
      </div>
      <ul class="list-disc list-inside text-xs text-red-600 ml-6">
        
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "ชื่อคอร์สเรียน", class: "block text-xs font-bold text-slate-700 mb-1.5 ml-1" %>
    <%= form.text_field :title, 
        placeholder: "เช่น การเขียนโปรแกรมเบื้องต้น",
        class: "block w-full px-3 py-2 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none" %>
  </div>

  <div>
    <%= form.label :description, "รายละเอียดคอร์ส", class: "block text-xs font-bold text-slate-700 mb-1.5 ml-1" %>
    <%= form.text_area :description, 
        rows: 4,
        placeholder: "อธิบายสั้นๆ...",
        class: "block w-full px-3 py-2 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all duration-200 outline-none resize-none" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold py-2.5 px-4 rounded-xl shadow-md shadow-indigo-100 transition-all duration-200 cursor-pointer active:scale-95" %>
  </div>
<% end %>