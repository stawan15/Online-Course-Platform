<h1>แบบทดสอบทั้งหมด</h1>
<ul>
  <% @quizzes.each do |quiz| %>
    <li><%= link_to quiz.question, quiz_path(quiz) %></li>
    <li><%= link_to "แก้ไข", edit_quiz_path(quiz) %></li>
    <li><%= link_to "ลบ", quiz_path(quiz), method: :delete %></li>
  <% end %>
</ul>

<%= link_to "สร้างแบบทดสอบใหม่", new_quiz_path %> 