<div class="min-h-screen bg-slate-50">
  <div class="bg-amber-500 pt-20 pb-12 px-4 sm:px-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-amber-400/30 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/20 text-amber-950 uppercase tracking-widest backdrop-blur-sm border border-white/20 mb-4 cursor-default">
        รายละเอียดแบบทดสอบ
      </span>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 -mt-16 pb-16 relative z-20">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl shadow-slate-200/50 border border-slate-100 text-center text-slate-800">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-50 text-amber-500 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      
      <h2 class="text-2xl sm:text-3xl font-black mb-8 leading-relaxed"><%= @quiz.question %></h2>

      <% if @quiz.lesson %>
      <div class="inline-flex items-center justify-center space-x-2 bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200 mb-10 w-full sm:w-auto">
        <span class="text-slate-500 text-sm font-medium">ส่วนหนึ่งของบทเรียน:</span>
        <%= link_to @quiz.lesson.title, lesson_path(@quiz.lesson), class: "text-indigo-600 font-bold hover:underline transition-all" %>
      </div>
      <% end %>

      <%# #fill in the blank answer and save for next time%>
      <% if current_user %>
        <% @submission = current_user.quiz_submissions.find_or_initialize_by(quiz: @quiz) %>
        <%= form_with(model: @submission, url: submit_answer_quiz_path(@quiz), method: :patch, local: true) do |form| %>
          <div class="flex flex-col sm:flex-row items-center gap-3 p-4 bg-indigo-50 border border-indigo-100 rounded-xl w-full mb-8">
            <div class="flex-grow w-full">
              <%= form.text_field :answer, placeholder: "พิมพ์คำตอบของคุณที่นี่...", class: "w-full px-4 py-3 bg-white border border-indigo-200 text-slate-700 text-sm font-medium rounded-xl transition-all focus:ring-2 focus:ring-indigo-500 outline-none" %>
            </div>
            <%=form.submit "บันทึกคำตอบ", class: "w-full sm:w-auto flex-shrink-0 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl transition-all shadow-md shadow-indigo-200 cursor-pointer" %>
          </div>
        <% end %>
      <% end %>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-8 border-t border-slate-100">
        <%= link_to :back, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-indigo-600 bg-slate-50 hover:bg-slate-100 rounded-xl transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          กลับไปก่อนหน้า
        <% end %>
      
        <%if can? :edit, @quiz %>
          <%= link_to edit_quiz_path(@quiz), class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-sm font-bold rounded-xl transition-all" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            แก้ไขคำถาม
          <% end %>
        <%end%>

        

        
      </div>
    </div>
  </div>
</div>
