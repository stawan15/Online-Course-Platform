<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">โปรไฟล์ทั้งหมด</h1>
        <p class="text-slate-500 text-sm">จัดการข้อมูลผู้ใช้งานและผู้สอน</p>
      </div>
      <%= link_to new_profile_path, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all duration-200 active:scale-95 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5 group-hover:rotate-90 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        สร้างโปรไฟล์ใหม่
      <% end %>
    </div>

    <% if @profiles.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <% @profiles.each do |profile| %>
          <div class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col h-full hover:-translate-y-0.5">
            <div class="p-6 flex-grow">
              <div class="flex justify-between items-start mb-3">
                <%# #show roles %>
                <% if profile.user.has_role?(:admin) %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-red-100 text-red-700 uppercase tracking-wider border border-red-200">
                    Admin
                  </span>
                <% end %>
                <% if profile.user.has_role?(:instructor) %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-100 text-blue-700 uppercase tracking-wider border border-blue-200">
                    Instructor
                  </span>
                <% end %>
                <% if profile.user.has_role?(:student) %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-green-100 text-green-700 uppercase tracking-wider border border-green-200">
                    Student
                  </span>
                <% end %>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <%= link_to edit_profile_path(profile), class: "p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg> 
                  <% end %>
                  <%= button_to profile_path(profile), method: :delete, data: { turbo_confirm: "ต้องการย้ายโปรไฟล์นี้ไปที่ถังขยะใช่หรือไม่?" }, class: "p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center space-x-3 mb-4 mt-2">
                <div class="w-10 h-10 rounded-full bg-teal-500 flex items-center justify-center text-white font-bold capitalize text-sm shadow-sm ring-2 ring-white">
                  <%= (profile.user.name.presence || profile.user.email)[0] if profile.user %>
                </div>
                <div>
                  <h2 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-1"><%= profile.user.name.presence || "ไม่มีชื่อ" if profile.user %></h2>
                  <p class="text-xs text-slate-500"><%= profile.user.email if profile.user %></p>
                </div>
              </div>
              <p class="text-slate-500 text-xs leading-relaxed line-clamp-2 mt-4 pt-4 border-t border-slate-50">
                <%= profile.bio.presence || "ยังไม่มีข้อมูลประวัติผู้ใช้งาน" %>
              </p>
            </div>
            
            <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-50 mt-auto">
              <%= link_to profile_path(profile), class: "flex items-center justify-between group/link text-indigo-600 text-sm font-bold" do %>
                <span>ดูโปรไฟล์</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="h-3.5 w-3.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl border-2 border-dashed border-slate-200 mb-8">
        <div class="bg-teal-50 w-12 h-12 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="h-6 w-6 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">ยังไม่มีโปรไฟล์ผู้ใช้งาน</h3>
        <p class="text-slate-500 text-sm mb-6">ผู้ใช้งานยังไม่มีการสร้างโปรไฟล์เพิ่มเติม</p>
        <%= link_to "สร้างโปรไฟล์ใหม่", new_profile_path, class: "text-indigo-600 text-sm font-bold hover:text-indigo-700 underline underline-offset-4" %>
      </div>
    <% end %>
  </div>
</div>