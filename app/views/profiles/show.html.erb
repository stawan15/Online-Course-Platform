<div class="min-h-screen bg-slate-50 pb-16">
  <!-- Profile Header -->
  <div class="h-64 sm:h-80 bg-gradient-to-tr from-teal-600 to-indigo-600 relative overflow-hidden">
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-teal-400/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-indigo-400/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 -mt-32">
    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
      <div class="p-8 sm:p-12">
        <div class="flex flex-col sm:flex-row items-center sm:items-end gap-6 sm:gap-8 mb-10 -mt-100 sm:mt-5">
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-teal-500 border-4 border-white shadow-lg flex items-center justify-center text-white text-5xl font-bold uppercase ring-4 ring-slate-50">
            <%= (@profile.user.name.presence || @profile.user.email)[0] if @profile.user %>
          </div>
          
          <div class="flex-grow text-center sm:text-left">
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-2">
              <%= @profile.user.name.presence || "ไม่มีชื่อ" if @profile.user %>
            </h1>
            <p class="text-slate-500 font-medium bg-slate-100 inline-flex px-3 py-1 rounded-lg text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <%= @profile.user.email if @profile.user %>
            </p>
          </div>

          <div class="flex items-center gap-3 mt-4 sm:mt-0">
            <%= link_to edit_profile_path(@profile), class: "inline-flex items-center justify-center px-6 py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-sm font-bold rounded-xl transition-all shadow-sm" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              แก้ไขโปรไฟล์
            <% end %>
          </div>
        </div>

        <div class="prose prose-slate max-w-none">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-4 mb-6 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="h-5 w-5 mr-2 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            ประวัติเกี่ยวกับฉัน
          </h2>
          <div class="text-slate-600 leading-relaxed min-h-[100px] bg-slate-50 p-6 rounded-2xl border border-slate-100/50">
            <%= simple_format(@profile.bio.presence || "ยังไม่มีการเพิ่มข้อมูลประวัติส่วนตัว ผู้ใช้ท่านนี้ยังไม่ได้เขียนอะไรเพิ่มเติมเกี่ยวกับตัวเอง") %>
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-slate-100 text-center">
          <%= link_to profiles_path, class: "inline-flex items-center text-sm font-bold text-slate-400 hover:text-indigo-600 transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            กลับไปหน้ารวมโปรไฟล์
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
