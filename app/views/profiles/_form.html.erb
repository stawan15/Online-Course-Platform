<%= form_with(model: profile, class: "space-y-5") do |form| %>
  <% if profile.errors.any? %>
    <div id="error_explanation" class="bg-red-50 p-4 rounded-xl border border-red-100">
      <div class="flex items-center space-x-2 text-red-800 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="font-bold text-sm">ไม่สามารถบันทึกข้อมูลได้ (<%= profile.errors.count %> ข้อ)</span>
      </div>
      <ul class="list-disc list-inside text-sm text-red-600 ml-7 space-y-1">
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "ชื่อ", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.text_field :name, 
        placeholder: "ชื่อ",
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 transition-all duration-200 outline-none" %>
  </div>
  <div>
    <%= form.label :user_id, "ผู้ใช้งาน", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.collection_select :user_id, User.all, :id, :email, { prompt: "เลือกผู้ใช้งาน" },
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 transition-all duration-200 outline-none" %>
  </div>

  <div>
    <%= form.label :bio, "ประวัติส่วนตัว", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
    <%= form.text_area :bio, 
        rows: 6,
        placeholder: "แนะนำตัวสั้นๆ เพื่อให้ผู้อื่นรู้จักคุณมากขึ้น...",
        class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 transition-all duration-200 outline-none resize-none" %>
  </div>
  <%if current_user.has_role?(:admin) %>
    <div>
      <%# #admin can change role for user %>
      <%= form.label :role, "บทบาท", class: "block text-sm font-bold text-slate-700 mb-2 ml-1" %>
      <% if can?(:manage, Profile) %>
        <%=form.collection_select :role, @roles, :id, :name, { prompt: "เลือกบทบาท" },
            class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 transition-all duration-200 outline-none" %>
      <% else %>
        <%=form.collection_select :role, @roles, :id, :name, { prompt: "เลือกบทบาท" },
            disabled: true,
            class: "block w-full px-4 py-3 text-sm rounded-xl border-slate-200 bg-slate-100 cursor-not-allowed outline-none opacity-70" %>
      <% end %>
    </div>
  <% end %>

  <div class="pt-4">
    <%= form.submit class: "w-full bg-teal-600 hover:bg-teal-700 text-white text-base font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-teal-100 transition-all duration-200 cursor-pointer active:scale-95" %>
  </div>

  
<% end %>